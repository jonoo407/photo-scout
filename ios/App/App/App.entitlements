<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Push Notification service. "production" is what TestFlight and
	     App Store builds use; an Xcode debug build registers against sandbox,
	     which the Worker handles by retrying there on BadDeviceToken. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
