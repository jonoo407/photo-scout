# The auth-configured e2e build (`npm run build:e2e-auth`, mode e2e-auth).
#
# Production is built with the Supabase URL + key set (Cloudflare build vars),
# but a plain `npm run build` has neither, so auth is OFF and CI never saw what
# a signed-out visitor sees. This build turns auth ON against a host that does
# not exist; e2e/supabase-stub.ts answers every request to it, so the guest
# suite is hermetic. Nothing here is a secret (and it points nowhere real).
VITE_SUPABASE_URL=https://stub.supabase.test
VITE_SUPABASE_ANON_KEY=e2e-anon-key
VITE_AUTH_GOOGLE=1
