# Production build flags. Safe to commit: every VITE_-prefixed value is
# compiled into the client bundle, so nothing here can be a secret.
#
# Google sign-in is gated so a half-configured project never shows a dead
# button. Enabled 2026-07-29 once the OAuth client existed and the provider
# was switched on in Supabase.
VITE_AUTH_GOOGLE=1
